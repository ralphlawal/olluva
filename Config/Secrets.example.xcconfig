// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Nothing here is a secret in the cryptographic sense — the anon key is public
// by design and protected by Row Level Security — but none of it belongs in
// source control. NEVER put the service_role key in this file or in the app.

DEVELOPMENT_TEAM = ABCDE12345
APP_BUNDLE_ID = com.yourcompany.yourapp
APP_GROUP_ID = group.com.yourcompany.yourapp

SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = eyJ...
