# Secrets for the Supabase Edge Functions. Set them with:
#   supabase secrets set --env-file .env
# Copy this file to .env (git-ignored) and fill in. Never commit real values.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to
# functions by the platform; you do not set them.

# --- App identity -----------------------------------------------------------
APPLE_BUNDLE_ID=com.yourcompany.yourapp
# Comma-separated product identifiers created in App Store Connect.
APPLE_PRODUCT_IDS=com.yourcompany.yourapp.premium.yearly,com.yourcompany.yourapp.premium.monthly
# "true" only in development / TestFlight projects. Leave unset in production
# so sandbox and Xcode test purchases can never grant premium there.
APPLE_ALLOW_SANDBOX=

# --- Apple Push Notification service ---------------------------------------
# From the Apple Developer portal: Keys > create a key with APNs enabled.
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=ABCDE12345
# Contents of the .p8 file, with newlines written as \n.
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Scheduled workers -------------------------------------------------------
# Long random string shared between pg_cron and the worker functions
# (send-push, purge-storage). Generate with: openssl rand -hex 32
CRON_SECRET=

# The iOS app itself is configured in Config/Secrets.xcconfig, not here.
